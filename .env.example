# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database
# Local SQLite database URL. Render supplies DATABASE_URL for PostgreSQL.
DATABASE_URL=sqlite:///freedom_park.db

# Authentication / OTP
# In development, OTP_MOCK_MODE=True accepts bypass code '123456'
OTP_MOCK_MODE=True
OTP_MOCK_CODE=123456

# Payment Service (SANDBOX mode for development)
PAYMENT_MODE=SANDBOX
PAYMENT_PROVIDER=MOCK
PAYMENT_KEY=mock_sandbox_key
PAYMENT_SECRET=mock_sandbox_secret

# Notification & WhatsApp Service
WHATSAPP_PROVIDER=MOCK
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI & External APIs (Optional / Configurable)
GEMINI_API_KEY=
MAPS_API_KEY=
